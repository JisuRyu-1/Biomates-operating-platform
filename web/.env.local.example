# Copy this file to .env.local and fill in real values.
# See docs/google-sso-setup.md for how to get these from your Supabase project.
# .env.local is gitignored — never commit real credentials.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key (Supabase dashboard → Settings → API → service_role).
# No NEXT_PUBLIC_ prefix: this bypasses Row Level Security entirely, so it
# must stay server-only. Used only by lib/supabase/service.ts, for the
# public /api/register and /api/registrations/[id] routes that read/write
# the registrations table without an authenticated admin session.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (email) — see docs/resend-email-setup.md.
# No NEXT_PUBLIC_ prefix: server-only, read in lib/messaging/resend.ts
# and the /api/admin/emails/send route handler.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SOLAPI (SMS) — see docs/solapi-sms-setup.md.
# No NEXT_PUBLIC_ prefix: server-only, read in lib/messaging/solapi.ts
# and the /api/admin/messages/send route handler.
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_NUMBER=
