# Copy this file to .env.local and fill in real values.
# See docs/google-sso-setup.md for how to get these from your Supabase project.
# .env.local is gitignored — never commit real credentials.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ALIGO SMS/LMS — see docs/aligo-sms-setup.md.
# No NEXT_PUBLIC_ prefix: these must stay server-only (read only in
# lib/messaging/aligo.ts and the /api/admin/messages/send route handler).
ALIGO_USER_ID=
ALIGO_API_KEY=
ALIGO_SENDER_PHONE=

# Resend (email) — see docs/resend-email-setup.md.
# No NEXT_PUBLIC_ prefix: server-only, read in lib/messaging/resend.ts
# and the /api/admin/emails/send route handler.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
